# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=postgresql://fragrance:fragrancepass123@localhost:5432/fragrance_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fragrance_db
DB_USER=fragrance
DB_PASSWORD=fragrancepass123

# ===== AUTHENTICATION & SECURITY =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# ===== CORS & DOMAIN CONFIG =====
CORS_ORIGIN=http://localhost:3000,http://localhost,https://xyong.ccwu.cc
ALLOWED_DOMAINS=xyong.ccwu.cc,localhost

# ===== PAYMENT GATEWAY =====
# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# Alipay (支付宝) Configuration
ALIPAY_APPID=your_alipay_appid
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# WeChat Pay (微信支付) Configuration
WECHAT_PAY_APPID=your_wechat_appid
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_API_KEY=your_wechat_api_key
WECHAT_PAY_CERT_PATH=/certs/apiclient_cert.pem

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== FILE UPLOAD =====
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# ===== EMAIL CONFIGURATION =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@xyong.ccwu.cc

# ===== AWS/CLOUD STORAGE (Optional) =====
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=fragrance-yunnan-uploads

# ===== REDIS CACHE (Optional) =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===== INTERNATIONALIZATION =====
DEFAULT_LANGUAGE=zh
SUPPORTED_LANGUAGES=zh,en,ja,ko

# ===== LOGGING & MONITORING =====
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOGLEVEL=info

# ===== ADMIN CONFIG =====
ADMIN_EMAIL=admin@xyong.ccwu.cc
ADMIN_PHONE=+86-your-phone
