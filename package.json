{
  "name": "fragrance-yunnan",
  "version": "1.0.0",
  "description": "Enterprise-grade cross-border e-commerce platform for premium Yunnan essential oils",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "echo 'Frontend build (minify CSS/JS)'",
    "build:backend": "echo 'Backend compiled and ready'",
    "test": "NODE_OPTIONS=--experimental-vm-modules node --loader=@swc-node/register ./node_modules/.bin/jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,md,json}\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "docker:build": "docker build -t fragrance-yunnan:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "essential-oils",
    "e-commerce",
    "cross-border",
    "yunnan",
    "fragrance"
  ],
  "author": "Xynong",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pg-promise": "^11.5.4",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "validator": "^13.11.0",
    "express-async-errors": "^3.1.1",
    "stripe": "^14.8.0",
    "axios": "^1.6.5",
    "nodemailer": "^6.9.7",
    "multer": "^1.4.5-lts.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "i18next": "^23.7.6",
    "redis": "^4.6.12",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "@swc-node/register": "^1.6.8",
    "supertest": "^6.3.3",
    "@testing-library/node": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
